<!DOCTYPE html>
<!--[if IE 9]>
<html class="no-js lt-ie9" lang="{{ langCode }}" id="{{ htmlId }}"><!--<![endif]-->
<!--[if gt IE 9]><!-->
<html class="no-js" lang="{{ langCode }}" id="{{ htmlId }}">
<!--<![endif]-->
<head>
     <meta charset="utf-8">
     <meta https-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
      <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
         <title>{% if pageTitle %}{{ pageTitle }}  |  {% endif %}{{ site.title }}</title>
         <link rel="stylesheet" type="text/css" media="all" href="{{ site.css }}">
{% if 'tosros' in scripts %}<link rel="stylesheet" id="_tosros-css" href="{{ site.pluginCss.tosros }}" media="all">{% endif %}
{% if 'bxslider' in scripts %}<link rel="stylesheet" id="_bxslider-css" href="{{ site.pluginCss.bxslider }}" media="all">{% endif %}
         <link rel="profile" href="http://gmpg.org/xfn/11">
       <meta name="robots" content="max-image-preview:large">
       <script src="{{ site.js.headjs }}"></script>
{% for s in scripts %}
        <script type="text/javascript" src="{{ site.js[s] }}"></script>
{% endfor %}
<script type="text/javascript">head.js(
{% for s in scripts %}
{"_{{ s }}":"{{ site.js[s] }}"}{{ ", " if not loop.last }}{% endfor %});</script>
       <style id="flaviotavares-inline-css">
img:is([sizes=auto i],[sizes^="auto," i]){contain-intrinsic-size:3000px 1500px}
       </style>
       <script>
    function getBreakpointLabel() {
         var win_w = $(window).width(),
             labels = ['smart', 'tablet', 'tablet', 'desktop', 'original'],
             breakpoints = [320, 600, 768, 1024, 1025],
             length = breakpoints.length,
             selected = labels[0];

         for (i=0; i<length; i++) {
             if (breakpoints[i] < win_w) {
                 selected = labels[i];
                 }
             }

         return selected;
        }
       </script>
</head>
<body class="{{ bodyClass }}"{{ styleAttr }}>
<div id="doc">
{%- include "partials/header.njk" -%}
{{ content | safe }}
{%- include "partials/footer.njk" -%}
